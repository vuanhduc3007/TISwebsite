MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tiscms_app
MYSQL_PASSWORD=
MYSQL_DATABASE=solar_shop
# Enable for any database connection that leaves the trusted private host/network.
MYSQL_SSL=false
# Optional PEM CA; encode line breaks as \n when the platform requires one-line env values.
MYSQL_SSL_CA=

# Authentication and audit hashing (use long, random, different production values)
SESSION_SECRET=
AUDIT_HASH_SECRET=
# Production login/contact/Admin mutations FAIL CLOSED unless both are configured.
# The proxy must overwrite ONE client IP and x-tis-proxy-token; never append a chain.
TRUSTED_PROXY_IP_HEADER=x-real-ip
# New deployment-only secret shared with the reverse proxy (32-256 random characters).
# Do not expose it to the browser, logs or Git. See docs/production-hardening.md.
TRUSTED_PROXY_SECRET=

# Enable only after HTTPS works on the main domain and every subdomain.
ENABLE_HSTS=false

# Media: "cloudinary" in production; "local" is development-only
MEDIA_PROVIDER=local
# Server-owned namespace. Use a different value for test/staging and production.
MEDIA_STORAGE_PREFIX=tiscms
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender address and actual customer recipient; both required in production.
SMTP_FROM=
CONTACT_EMAIL=
# Optional reply-to; defaults to SMTP_FROM (no hard-coded unrelated domain).
SMTP_REPLY_TO=

# One-time owner bootstrap; remove after running npm run admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Safety confirmations must equal MYSQL_DATABASE when running one-time scripts.
CONFIRM_ADMIN_MIGRATION=
CONFIRM_ADMIN_CREATE=

# One-time owner recovery only; remove immediately after use.
ADMIN_RECOVERY_PASSWORD=
CONFIRM_ADMIN_PASSWORD_RESET=
