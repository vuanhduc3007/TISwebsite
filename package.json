{
  "name": "tisolar-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run admin:create && next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.mjs",
    "test:hardening-smoke": "node scripts/hardening-smoke.mjs",
    "production:config-check": "node --conditions=react-server --experimental-strip-types scripts/check-production-config.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:preflight:admin": "node scripts/preflight-admin-cms.mjs",
    "db:migrate:admin": "node scripts/migrate-admin-cms.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:recover-owner": "node --conditions=react-server --experimental-strip-types scripts/reset-owner-password.mjs",
    "test:admin-recovery": "node --conditions=react-server --experimental-strip-types --test tests/admin-password-recovery.test.mjs",
    "media:e2e": "node --conditions=react-server --experimental-strip-types scripts/cloudinary-e2e.mjs",
    "media:db-e2e": "node --conditions=react-server --experimental-strip-types scripts/cloudinary-db-e2e.mjs",
    "media:preflight:test": "node scripts/preflight-cloudinary-test.mjs",
    "media:verify-client-secret": "node scripts/verify-client-secret.mjs",
    "media:reconcile": "node scripts/reconcile-cloudinary.mjs",
    "media:reconcile:test": "node scripts/reconcile-cloudinary.mjs --test-env"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tabler/icons-react": "^3.34.1",
    "mysql2": "^3.23.2",
    "next": "16.3.8",
    "nodemailer": "10.0.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.3"
  }
}
