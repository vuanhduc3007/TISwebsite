      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');\n  .contact-protocol {\n    font-family: 'Manrope', Arial, sans-serif;\n  }\n  .contact-protocol-grid {\n    background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);\n    background-size: 48px 48px;\n    mask-image: linear-gradient(to bottom, transparent, black 22%, black 78%, transparent);\n  }\n  .contact-protocol-noise {\n    background-image: radial-gradient(circle at 78% 18%, rgba(253,200,0,.10), transparent 25%), radial-gradient(circle at 14% 76%, rgba(24,49,83,.24), transparent 28%);\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .contact-protocol a { transition: none !important; }\n  }\n</style>\n<section aria-labelledby=\"contact-title\" class=\"contact-protocol relative isolate overflow-hidden bg-[#050505] text-white\" data-kid=\"1\" data-name=\"contact section\" id=\"contact\">\n    <div aria-hidden=\"true\" class=\"contact-protocol-grid pointer-events-none absolute inset-0 opacity-60\" data-kid=\"1-1\" data-name=\"background grid pattern container\">\n    </div>\n    <div aria-hidden=\"true\" class=\"contact-protocol-noise pointer-events-none absolute inset-0\" data-kid=\"1-2\" data-name=\"background radial noise overlay\">\n    </div>\n    <div class=\"relative mx-auto w-full max-w-[1400px] px-4 py-12 sm:px-8 sm:py-16 lg:px-12 lg:py-20\" data-kid=\"1-3\" data-name=\"contact content layout container\">\n        <div class=\"flex flex-col gap-3 border-b border-[#27303a] pb-4 text-[10px] font-bold uppercase tracking-[0.22em] text-[#7c8794] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1\" data-name=\"section header info row\">\n            <p class=\"m-0 text-[#fdc800]\" data-kid=\"1-3-1-1\" data-name=\"section category title\">\n                TIS / Contact protocol\n            </p>\n            <p class=\"m-0\" data-kid=\"1-3-1-2\" data-name=\"section descriptive subtitle\">\n                Bắt đầu đúng từ câu hỏi đúng\n            </p>\n        </div>\n        <div class=\"grid gap-12 pt-12 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-20 lg:pt-16\" data-kid=\"1-3-2\" data-name=\"contact details grid\">\n            <div class=\"min-w-0\" data-kid=\"1-3-2-1\" data-name=\"contact description and steps container\">\n                <div class=\"max-w-[800px]\" data-kid=\"1-3-2-1-1\" data-name=\"header and introduction container\">\n                    <p class=\"mb-5 text-xs font-bold uppercase tracking-[0.24em] text-[#fdc800]\" data-kid=\"1-3-2-1-1-1\" data-name=\"section index label\">\n                        03 / Tiếp theo\n                    </p>\n                    <h2 class=\"m-0 max-w-[760px] text-[clamp(2.8rem,6.2vw,5.9rem)] font-extrabold leading-[0.98] tracking-[-0.065em] text-white\" data-kid=\"1-3-2-1-1-2\" data-name=\"hero section headline\" id=\"contact-title\">\n                        Bắt đầu từ một\n                        <br class=\"hidden sm:block\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"line break element\"/>\n                        cuộc\n                        <span class=\"text-[#fdc800]\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"highlighted text span\">\n                            trao đổi\n                        </span>\n                    </h2>\n                    <p class=\"mt-7 max-w-[650px] text-base leading-7 text-[#a5afba] sm:mt-8 sm:text-lg sm:leading-8\" data-kid=\"1-3-2-1-1-3\" data-name=\"introduction description text\">\n                        Chia sẻ loại công trình và nhu cầu sử dụng. Đội ngũ TIS sẽ giúp bạn xác định giải pháp phù hợp nhất, tối ưu chi phí và hiệu năng.\n                    </p>\n                </div>\n                <div class=\"relative mt-12 max-w-[780px] sm:mt-16\" data-kid=\"1-3-2-1-2\" data-name=\"contact steps process container\">\n                    <div aria-hidden=\"true\" class=\"absolute bottom-7 left-[23px] top-7 w-px bg-gradient-to-b from-[#fdc800] via-[#4c5663] to-transparent\" data-kid=\"1-3-2-1-2-1\" data-name=\"connecting line graphic\">\n                    </div>\n                    <ol aria-label=\"Các bước trao đổi với TIS\" class=\"m-0 grid list-none gap-0 p-0\" data-kid=\"1-3-2-1-2-2\" data-name=\"ordered steps list\">\n                        <li class=\"group relative grid grid-cols-[48px_minmax(0,1fr)] gap-5 border-t border-[#27303a] py-5 sm:grid-cols-[58px_minmax(0,1fr)] sm:gap-7 sm:py-6\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"first step item\">\n                            <div class=\"relative z-10 grid h-12 w-12 place-items-center rounded-full border border-[#fdc800] bg-[#050505] text-xs font-extrabold tracking-[0.12em] text-[#fdc800] sm:h-14 sm:w-14\" data-kid=\"1-3-2-1-2-2-1-1\" data-name=\"step 1 number indicator\">\n                                01\n                            </div>\n                            <div class=\"relative min-w-0 pt-1\" data-kid=\"1-3-2-1-2-2-1-2\" data-name=\"step 1 details container\">\n                                <span aria-hidden=\"true\" class=\"absolute -left-7 top-8 hidden h-px w-5 origin-left rotate-[18deg] bg-[#fdc800]/70 sm:block\" data-kid=\"1-3-2-1-2-2-1-2-1\" data-name=\"connecting line indicator\">\n                                </span>\n                                <h3 class=\"m-0 text-lg font-extrabold tracking-[-0.02em] text-white sm:text-xl\" data-kid=\"1-3-2-1-2-2-1-2-2\" data-name=\"step 1 title\">\n                                    Hiện trạng\n                                </h3>\n                                <p class=\"m-0 mt-1.5 text-sm leading-6 text-[#7f8a96]\" data-kid=\"1-3-2-1-2-2-1-2-3\" data-name=\"step 1 description text\">\n                                    Công trình, quy mô và hệ thống đang có.\n                                </p>\n                            </div>\n                        </li>\n                        <li class=\"group relative grid grid-cols-[48px_minmax(0,1fr)] gap-5 border-t border-[#27303a] py-5 sm:grid-cols-[58px_minmax(0,1fr)] sm:gap-7 sm:py-6\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"second step item\">\n                            <div class=\"relative z-10 grid h-12 w-12 place-items-center rounded-full border border-[#4c5663] bg-[#050505] text-xs font-extrabold tracking-[0.12em] text-[#c5ccd4] transition-colors duration-200 group-hover:border-[#fdc800] group-hover:text-[#fdc800] sm:h-14 sm:w-14\" data-kid=\"1-3-2-1-2-2-2-1\" data-name=\"step 2 number indicator\">\n                                02\n                            </div>\n                            <div class=\"relative min-w-0 pt-1\" data-kid=\"1-3-2-1-2-2-2-2\" data-name=\"step 2 details container\">\n                                <span aria-hidden=\"true\" class=\"absolute -left-7 top-8 hidden h-px w-5 origin-left rotate-[18deg] bg-[#4c5663] transition-colors duration-200 group-hover:bg-[#fdc800]/70 sm:block\" data-kid=\"1-3-2-1-2-2-2-2-1\" data-name=\"connecting line indicator\">\n                                </span>\n                                <h3 class=\"m-0 text-lg font-extrabold tracking-[-0.02em] text-white sm:text-xl\" data-kid=\"1-3-2-1-2-2-2-2-2\" data-name=\"step 2 title\">\n                                    Bài toán\n                                </h3>\n                                <p class=\"m-0 mt-1.5 text-sm leading-6 text-[#7f8a96]\" data-kid=\"1-3-2-1-2-2-2-2-3\" data-name=\"step 2 description text\">\n                                    Mục tiêu sử dụng, ngân sách và ưu tiên.\n                                </p>\n                            </div>\n                        </li>\n                        <li class=\"group relative grid grid-cols-[48px_minmax(0,1fr)] gap-5 border-y border-[#27303a] py-5 sm:grid-cols-[58px_minmax(0,1fr)] sm:gap-7 sm:py-6\" data-kid=\"1-3-2-1-2-2-3\" data-name=\"third step item\">\n                            <div class=\"relative z-10 grid h-12 w-12 place-items-center rounded-full border border-[#4c5663] bg-[#050505] text-xs font-extrabold tracking-[0.12em] text-[#c5ccd4] transition-colors duration-200 group-hover:border-[#fdc800] group-hover:text-[#fdc800] sm:h-14 sm:w-14\" data-kid=\"1-3-2-1-2-2-3-1\" data-name=\"step 3 number indicator\">\n                                03\n                            </div>\n                            <div class=\"relative min-w-0 pt-1\" data-kid=\"1-3-2-1-2-2-3-2\" data-name=\"step 3 details container\">\n                                <span aria-hidden=\"true\" class=\"absolute -left-7 top-8 hidden h-px w-5 origin-left rotate-[18deg] bg-[#4c5663] transition-colors duration-200 group-hover:bg-[#fdc800]/70 sm:block\" data-kid=\"1-3-2-1-2-2-3-2-1\" data-name=\"connecting line indicator\">\n                                </span>\n                                <h3 class=\"m-0 text-lg font-extrabold tracking-[-0.02em] text-white sm:text-xl\" data-kid=\"1-3-2-1-2-2-3-2-2\" data-name=\"step 3 title\">\n                                    Giải pháp\n                                </h3>\n                                <p class=\"m-0 mt-1.5 text-sm leading-6 text-[#7f8a96]\" data-kid=\"1-3-2-1-2-2-3-2-3\" data-name=\"step 3 description text\">\n                                    Phương án phù hợp để cùng xem xét.\n                                </p>\n                            </div>\n                        </li>\n                    </ol>\n                </div>\n            </div>\n            <aside aria-label=\"Thông tin liên hệ TIS\" class=\"self-start rounded-2xl border border-[#2a3440] bg-[#101925]/95 p-5 shadow-[0_24px_80px_rgba(0,0,0,0.32)] sm:p-6 lg:mt-2\" data-kid=\"1-3-2-2\" data-name=\"contact info side card\">\n                <div class=\"flex items-start justify-between gap-4 border-b border-[#27303a] pb-5\" data-kid=\"1-3-2-2-1\" data-name=\"side card header\">\n                    <div data-kid=\"1-3-2-2-1-1\" data-name=\"header text container\">\n                        <p class=\"m-0 text-[10px] font-bold uppercase tracking-[0.2em] text-[#7c8794]\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"header small label\">\n                            Kênh liên hệ\n                        </p>\n                        <p class=\"m-0 mt-2 text-sm font-semibold text-[#d5dbe1]\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"header main instruction\">\n                            Chọn cách bắt đầu\n                        </p>\n                    </div>\n                    <span aria-hidden=\"true\" class=\"mt-0.5 h-2.5 w-2.5 rounded-full bg-[#fdc800] shadow-[0_0_0_5px_rgba(253,200,0,0.1)]\" data-kid=\"1-3-2-2-1-2\" data-name=\"active status indicator dot\">\n                    </span>\n                </div>\n                <div class=\"py-6\" data-kid=\"1-3-2-2-2\" data-name=\"hotline section container\">\n                    <p class=\"m-0 text-xs font-bold uppercase tracking-[0.2em] text-[#7c8794]\" data-kid=\"1-3-2-2-2-1\" data-name=\"hotline label\">\n                        Hotline tư vấn\n                    </p>\n                    <a aria-label=\"Gọi hotline tư vấn 0988 761 315\" class=\"mt-3 block whitespace-nowrap text-[clamp(1.9rem,4vw,2.65rem)] font-extrabold leading-none tracking-[-0.055em] text-[#fdc800] underline decoration-transparent underline-offset-8 transition-colors duration-200 hover:text-white hover:decoration-[#fdc800] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#fdc800] active:translate-y-px\" data-kid=\"1-3-2-2-2-2\" data-name=\"hotline telephone link\" href=\"tel:0988761315\">\n                        0988 761 315\n                    </a>\n                </div>\n                <div class=\"grid gap-3 border-t border-[#27303a] pt-5\" data-kid=\"1-3-2-2-3\" data-name=\"actions section container\">\n                    <a aria-label=\"Gửi yêu cầu trực tuyến cho TIS\" class=\"group inline-flex min-h-14 items-center justify-between gap-5 rounded-xl bg-[#fdc800] px-5 text-sm font-extrabold text-[#050505] transition-[transform,background-color] duration-200 hover:bg-[#ffcf2e] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#fdc800] active:translate-y-px active:scale-[0.99]\" data-kid=\"1-3-2-2-3-1\" data-name=\"contact web request button\" href=\"/contact\">\n                        <span data-kid=\"1-3-2-2-3-1-1\" data-name=\"button label text\">\n                            Gửi yêu cầu trực tuyến\n                        </span>\n                        <span aria-hidden=\"true\" class=\"text-xl leading-none transition-transform duration-200 group-hover:translate-x-1\" data-kid=\"1-3-2-2-3-1-2\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <p class=\"m-0 text-center text-[11px] leading-5 text-[#75818e]\" data-kid=\"1-3-2-2-3-2\" data-name=\"button description text\">\n                        Một cuộc trao đổi ngắn để bắt đầu đúng hướng.\n                    </p>\n                </div>\n            </aside>\n        </div>\n    </div>\n</section>\n",
