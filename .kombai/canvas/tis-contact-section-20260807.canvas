      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');\n  .signal-rail-section {\n    font-family: 'Manrope', Arial, sans-serif;\n    background:\n      radial-gradient(circle at 9% 8%, rgba(253, 200, 0, 0.08), transparent 24rem),\n      #050505;\n  }\n  .signal-rail-image {\n    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), filter 500ms ease;\n  }\n  .signal-rail-frame:hover .signal-rail-image,\n  .signal-rail-frame:focus-within .signal-rail-image {\n    transform: scale(1.035);\n    filter: saturate(1.08) contrast(1.04);\n  }\n  .signal-rail-cta {\n    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;\n  }\n  .signal-rail-cta:hover {\n    box-shadow: 0 10px 30px rgba(253, 200, 0, 0.18);\n  }\n  .signal-rail-cta:active {\n    transform: translateY(1px) scale(0.985);\n  }\n  .signal-rail-phone {\n    transition: color 180ms ease;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .signal-rail-image,\n    .signal-rail-cta,\n    .signal-rail-phone {\n      transition: none;\n    }\n  }\n</style>\n<section aria-labelledby=\"contact-title\" class=\"signal-rail-section relative isolate overflow-hidden border-t border-white/10 text-white\" data-kid=\"1\" data-name=\"contact section\" id=\"contact\">\n    <div class=\"pointer-events-none absolute inset-y-0 left-0 w-px bg-[#fdc800]/70\" data-kid=\"1-1\" data-name=\"left decorative border\">\n    </div>\n    <div class=\"mx-auto grid min-h-[720px] w-full max-w-[1400px] grid-cols-1 px-4 sm:px-6 lg:grid-cols-[minmax(0,1.16fr)_minmax(330px,0.72fr)] lg:px-10 xl:px-14\" data-kid=\"1-2\" data-name=\"contact content wrapper\">\n        <div class=\"flex flex-col justify-between py-12 sm:py-16 lg:py-20 lg:pr-16 xl:pr-24\" data-kid=\"1-2-1\" data-name=\"contact info and form container\">\n            <div data-kid=\"1-2-1-1\" data-name=\"header area container\">\n                <div class=\"mb-14 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.24em] text-white/45 sm:mb-20\" data-kid=\"1-2-1-1-1\" data-name=\"section label container\">\n                    <span aria-hidden=\"true\" class=\"h-2.5 w-2.5 bg-[#fdc800]\" data-kid=\"1-2-1-1-1-1\" data-name=\"label decoration square\">\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-2\" data-name=\"section label text\">\n                        TIS / 04 — TƯ VẤN & TRIỂN KHAI\n                    </span>\n                </div>\n                <h2 class=\"max-w-[760px] text-[3.45rem] font-extrabold leading-[0.94] tracking-[-0.075em] text-white sm:text-[5rem] lg:text-[6.2rem]\" data-kid=\"1-2-1-1-2\" data-name=\"contact section headline\" id=\"contact-title\">\n                    Bắt đầu từ một cuộc trao đổi\n                </h2>\n                <p class=\"mt-9 max-w-[38rem] text-base leading-7 text-[#94a3b8] sm:mt-10 sm:text-lg sm:leading-8\" data-kid=\"1-2-1-1-3\" data-name=\"contact section description\">\n                    Chia sẻ loại công trình và nhu cầu sử dụng. Đội ngũ TIS sẽ giúp bạn xác định giải pháp phù hợp nhất, tối ưu chi phí và hiệu năng.\n                </p>\n            </div>\n            <div class=\"mt-16 border-t border-white/15 pt-5 sm:mt-24 sm:pt-6\" data-kid=\"1-2-1-2\" data-name=\"contact actions area\">\n                <div class=\"grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-10\" data-kid=\"1-2-1-2-1\" data-name=\"contact action grid container\">\n                    <div data-kid=\"1-2-1-2-1-1\" data-name=\"hotline area container\">\n                        <p class=\"mb-3 text-[10px] font-bold uppercase tracking-[0.22em] text-white/40\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"hotline label text\">\n                            Hotline tư vấn\n                        </p>\n                        <a aria-label=\"Gọi hotline tư vấn 0988 761 315\" class=\"signal-rail-phone inline-block text-3xl font-extrabold tracking-[-0.05em] text-[#fdc800] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#fdc800] sm:text-4xl\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"hotline phone link\" href=\"tel:0988761315\">\n                            0988 761 315\n                        </a>\n                    </div>\n                    <a aria-label=\"Gửi yêu cầu trực tuyến cho TIS\" class=\"signal-rail-cta inline-flex min-h-14 items-center justify-center rounded-xl bg-[#fdc800] px-6 text-center text-sm font-extrabold uppercase tracking-[0.08em] text-black hover:bg-[#ffda33] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#fdc800] sm:px-8\" data-kid=\"1-2-1-2-1-2\" data-name=\"submit request button\" href=\"/contact\">\n                        Gửi yêu cầu trực tuyến\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"signal-rail-frame relative min-h-[390px] overflow-hidden border-x border-white/10 lg:min-h-0\" data-kid=\"1-2-2\" data-name=\"image frame container\">\n            <img alt=\"Kỹ thuật viên TIS kiểm tra hệ thống điện mặt trời trên mái nhà\" class=\"signal-rail-image absolute inset-0 h-full w-full object-cover object-[48%_50%] grayscale-[0.15]\" data-kid=\"1-2-2-1\" data-name=\"technician solar installation image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/projects/technician_solar.jpg\"/>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#050505]/80 via-[#050505]/10 to-[#050505]/10\" data-kid=\"1-2-2-2\" data-name=\"image gradient overlay\">\n            </div>\n            <div class=\"absolute left-0 top-0 flex items-center gap-3 bg-[#fdc800] px-4 py-3 text-[10px] font-extrabold uppercase tracking-[0.2em] text-black sm:px-5\" data-kid=\"1-2-2-3\" data-name=\"image label badge\">\n                <span aria-hidden=\"true\" class=\"h-2 w-2 rounded-full bg-black\" data-kid=\"1-2-2-3-1\" data-name=\"badge decoration dot\">\n                </span>\n                04 / KẾT NỐI\n            </div>\n            <div class=\"absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4 border-t border-white/35 pt-4 text-[10px] font-bold uppercase tracking-[0.18em] text-white/75 sm:bottom-7 sm:left-7 sm:right-7\" data-kid=\"1-2-2-4\" data-name=\"image information footer\">\n                <span data-kid=\"1-2-2-4-1\" data-name=\"design service text\">\n                    Thiết kế · Thi công\n                </span>\n                <span class=\"text-right text-[#fdc800]\" data-kid=\"1-2-2-4-2\" data-name=\"brand name text\">\n                    TIS ENERGY\n                </span>\n            </div>\n        </div>\n    </div>\n</section>\n",
