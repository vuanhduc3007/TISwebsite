      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');\n  .field-note-section { font-family: 'Manrope', Arial, sans-serif; }\n  .field-note-image { transform: scale(1.02); filter: saturate(.78) contrast(1.08) brightness(.52); }\n  .field-note-scrim { background: linear-gradient(90deg, rgba(5,5,5,.94) 0%, rgba(5,5,5,.72) 42%, rgba(5,5,5,.28) 76%, rgba(5,5,5,.64) 100%), linear-gradient(0deg, rgba(5,5,5,.74) 0%, transparent 38%, rgba(5,5,5,.2) 100%); }\n  .field-note-bracket { border-left: 1px solid #fdc800; border-top: 1px solid #fdc800; }\n  .field-note-bracket::after { content: ''; position: absolute; left: -1px; bottom: -38px; width: 1px; height: 38px; background: #fdc800; }\n  .field-note-panel { box-shadow: 0 24px 80px rgba(0,0,0,.32); }\n  @media (max-width: 767px) {\n    .field-note-scrim { background: linear-gradient(0deg, rgba(5,5,5,.97) 0%, rgba(5,5,5,.72) 48%, rgba(5,5,5,.28) 100%); }\n    .field-note-bracket::after { display: none; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .field-note-image { transform: none; }\n  }\n</style>\n<section class=\"field-note-section relative isolate min-h-[680px] overflow-hidden bg-[#050505] text-white md:min-h-[720px]\" data-kid=\"1\" data-name=\"field note section\" id=\"contact\">\n    <div class=\"absolute inset-0 -z-20 overflow-hidden\" data-kid=\"1-1\" data-name=\"background image container\">\n        <img alt=\"Khu lưu trữ năng lượng BESS quy mô công nghiệp\" class=\"field-note-image h-full w-full object-cover object-center\" data-kid=\"1-1-1\" data-name=\"BESS facility background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/projects/bess_facility.jpg\"/>\n    </div>\n    <div class=\"field-note-scrim absolute inset-0 -z-10\" data-kid=\"1-2\" data-name=\"scrim gradient overlay\">\n    </div>\n    <div class=\"site-shell relative z-10 flex min-h-[680px] w-full flex-col justify-between py-8 md:min-h-[720px] md:py-12\" data-kid=\"1-3\" data-name=\"section content wrapper\">\n        <div class=\"flex items-start justify-between gap-6 text-[10px] font-bold uppercase tracking-[0.24em] text-white/55 md:text-xs\" data-kid=\"1-3-1\" data-name=\"section header info\">\n            <p class=\"m-0\" data-kid=\"1-3-1-1\" data-name=\"project identifier text\">\n                TIS / 04\n            </p>\n            <p class=\"m-0 text-right\" data-kid=\"1-3-1-2\" data-name=\"consultation contact link\">\n                Liên hệ tư vấn\n                <span class=\"ml-2 text-[#fdc800]\" data-kid=\"1-3-1-2-1\" data-name=\"status dot icon\">\n                    ●\n                </span>\n            </p>\n        </div>\n        <div class=\"grid items-end gap-12 pb-6 md:grid-cols-[minmax(0,1fr)_390px] md:gap-16 md:pb-10 lg:grid-cols-[minmax(0,1fr)_430px]\" data-kid=\"1-3-2\" data-name=\"content grid container\">\n            <div class=\"max-w-3xl\" data-kid=\"1-3-2-1\" data-name=\"project inquiry callout area\">\n                <div class=\"field-note-bracket relative mb-7 h-10 w-10 md:mb-9 md:h-12 md:w-12\" data-kid=\"1-3-2-1-1\" data-name=\"decorative corner bracket\">\n                </div>\n                <p class=\"mb-4 text-[10px] font-bold uppercase tracking-[0.26em] text-[#fdc800] md:text-xs\" data-kid=\"1-3-2-1-2\" data-name=\"pre-headline label\">\n                    Bước tiếp theo\n                </p>\n                <h2 class=\"m-0 max-w-[760px] text-4xl font-extrabold leading-[1.04] tracking-[-0.055em] text-white sm:text-5xl md:text-6xl lg:text-[76px]\" data-kid=\"1-3-2-1-3\" data-name=\"section headline\">\n                    Bắt đầu từ một cuộc trao đổi\n                </h2>\n                <p class=\"mt-6 max-w-[590px] text-base leading-7 text-slate-200/78 md:mt-7 md:text-lg md:leading-8\" data-kid=\"1-3-2-1-4\" data-name=\"section description text\">\n                    Chia sẻ loại công trình và nhu cầu sử dụng. Đội ngũ TIS sẽ giúp bạn xác định giải pháp phù hợp nhất, tối ưu chi phí và hiệu năng.\n                </p>\n                <p class=\"mt-8 max-w-[480px] border-l border-white/25 pl-4 text-[11px] uppercase leading-5 tracking-[0.16em] text-white/50 md:mt-10\" data-kid=\"1-3-2-1-5\" data-name=\"project note metadata\">\n                    Ghi chú dự án · Hệ thống lưu trữ năng lượng cho công trình tại Việt Nam\n                </p>\n            </div>\n            <div class=\"field-note-panel rounded-2xl border border-black/10 bg-white p-6 text-[#101925] sm:p-8 md:mb-2 md:p-9\" data-kid=\"1-3-2-2\" data-name=\"contact inquiry card\">\n                <p class=\"m-0 text-[10px] font-extrabold uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-3-2-2-1\" data-name=\"hotline label text\">\n                    Hotline tư vấn\n                </p>\n                <a class=\"mt-3 block whitespace-nowrap text-[clamp(2rem,5vw,3.3rem)] font-extrabold leading-none tracking-[-0.06em] text-[#101925] no-underline hover:text-[#fdc800] focus-visible:outline-3 focus-visible:outline-[#fdc800] focus-visible:outline-offset-4\" data-kid=\"1-3-2-2-2\" data-name=\"hotline telephone link\" href=\"tel:0988761315\">\n                    0988 761 315\n                </a>\n                <div class=\"my-7 h-px bg-slate-200\" data-kid=\"1-3-2-2-3\" data-name=\"divider line\">\n                </div>\n                <p class=\"mb-5 max-w-[260px] text-sm leading-6 text-slate-600\" data-kid=\"1-3-2-2-4\" data-name=\"card description text\">\n                    Trao đổi trực tiếp để bắt đầu từ đúng bài toán của công trình.\n                </p>\n                <a class=\"inline-flex min-h-14 w-full items-center justify-between rounded-xl bg-[#fdc800] px-5 text-sm font-extrabold uppercase tracking-[0.12em] text-[#050505] no-underline hover:bg-[#ffcf26] active:translate-y-px focus-visible:outline-3 focus-visible:outline-[#101925] focus-visible:outline-offset-4\" data-kid=\"1-3-2-2-5\" data-name=\"online request call-to-action button\" href=\"/contact\">\n                    <span data-kid=\"1-3-2-2-5-1\" data-name=\"button text\">\n                        Gửi yêu cầu trực tuyến\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-xl leading-none\" data-kid=\"1-3-2-2-5-2\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>\n",
